    <button class="btn l" onmousedown="move('left')" onmouseup="move('stop')" ontouchstart="move('left')" ontouchend="move('stop')">◀</button>
    <button class="btn s" onclick="move('stop')">■</button>
    <button class="btn r" onmousedown="move('right')" onmouseup="move('stop')" ontouchstart="move('right')" ontouchend="move('stop')">▶</button>
    <button class="btn d" onmousedown="move('down')" onmouseup="move('stop')" ontouchstart="move('down')" ontouchend="move('stop')">▼</button>
  </div>
  <script>
    function move(dir) {
      fetch(`/control?var=${dir}&t=${Date.now()}`);
    }
  </script>

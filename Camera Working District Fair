void sendsignal(int u, int d, int l, int r) {
  digitalWrite(sig_up, u);
  digitalWrite(sig_down, d);
  digitalWrite(sig_left, l);
  digitalWrite(sig_right, r);
}

// ====================== RELIABLE STREAM (HIGH PRIORITY) ======================
static esp_err_t stream_handler(httpd_req_t *req) {
  camera_fb_t * fb = NULL;
  esp_err_t res = ESP_OK;
  char part_buf[64];

  httpd_resp_set_type(req, _STREAM_CONTENT_TYPE);
  while (true) {
    fb = esp_camera_fb_get();
    if (!fb) { Serial.println("Camera capture failed"); res = ESP_FAIL; break; }

    res = httpd_resp_send_chunk(req, _STREAM_BOUNDARY, strlen(_STREAM_BOUNDARY));
    if (res == ESP_OK) {
      size_t hlen = snprintf(part_buf, 64, _STREAM_PART, fb->len);
      res = httpd_resp_send_chunk(req, part_buf, hlen);
    }
    if (res == ESP_OK) {
      res = httpd_resp_send_chunk(req, (const char *)fb->buf, fb->len);
    }
    esp_camera_fb_return(fb);
    if (res != ESP_OK) break;
  }
  return res;
}

// ====================== CONTROL (buttons) ======================
static esp_err_t control_handler(httpd_req_t *req) {
  char buf[64];
  char param[32] = "stop";

  if (httpd_req_get_url_query_str(req, buf, sizeof(buf)) == ESP_OK) {
    httpd_query_key_value(buf, "var", param, sizeof(param));
  }

  Serial.printf("Button: %s\n", param);

  // Temporary drop quality when moving (gives camera priority but keeps buttons snappy)
  if (strcmp(param, "stop") != 0) {
    sensor_t *s = esp_camera_sensor_get();
    s->set_quality(s, 30);        // lower quality while moving
    s->set_framesize(s, FRAMESIZE_QVGA);
  } else {
    sensor_t *s = esp_camera_sensor_get();
    s->set_quality(s, 20);        // restore high quality when stopped
    s->set_framesize(s, FRAMESIZE_QVGA);
  }

  // === YOUR MOTOR MAPPING (adjusted from your description) ===
  if (strcmp(param, "up") == 0)      sendsignal(1, 0, 1, 0);   // both forward
  else if (strcmp(param, "down") == 0) sendsignal(0, 1, 0, 1);   // both backward
  else if (strcmp(param, "left") == 0) sendsignal(0, 1, 1, 0);   // ← CHANGE IF WRONG
  else if (strcmp(param, "right") == 0) sendsignal(1, 0, 0, 1);  // ← CHANGE IF WRONG
  else sendsignal(0, 0, 0, 0);

  httpd_resp_set_hdr(req, "Cache-Control", "no-cache");
  return httpd_resp_send(req, "OK", 2);
}

// ====================== SETUP ======================
void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("Starting Endoscopy Robot...");

  // Motors off
  pinMode(sig_up, OUTPUT); digitalWrite(sig_up, 0);
  pinMode(sig_down, OUTPUT); digitalWrite(sig_down, 0);
  pinMode(sig_left, OUTPUT); digitalWrite(sig_left, 0);
  pinMode(sig_right, OUTPUT); digitalWrite(sig_right, 0);

  // Camera - optimized for stable stream
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM; config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM; config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM; config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM; config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM; config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM; config.pin_href = HREF_GPIO_NUM;
  config.pin_sscb_sda = SIOD_GPIO_NUM; config.pin_sscb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM; config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size   = FRAMESIZE_QVGA;     // best balance
  config.jpeg_quality = 20;
  config.fb_count     = 2;
  config.fb_location  = CAMERA_FB_IN_PSRAM;
  config.grab_mode    = CAMERA_GRAB_LATEST;

  if (esp_camera_init(&config) != ESP_OK) {
    Serial.println("Camera failed! Check cable & PSRAM");
    return;
  }
  Serial.println("Camera OK - Stream has priority");

  WiFi.softAP(ssid, password);
  Serial.print("AP IP: "); Serial.println(WiFi.softAPIP());

  // Start server
  httpd_config_t config_http = HTTPD_DEFAULT_CONFIG();
  httpd_handle_t server = NULL;
  if (httpd_start(&server, &config_http) == ESP_OK) {
    httpd_uri_t index_uri = { .uri = "/", .method = HTTP_GET, .handler = [](httpd_req_t *req){
      httpd_resp_set_type(req, "text/html"); return httpd_resp_send(req, (const char*)index_html, strlen(index_html));
    }, .user_ctx = NULL };
    httpd_register_uri_handler(server, &index_uri);

    httpd_uri_t stream_uri = { .uri = "/stream", .method = HTTP_GET, .handler = stream_handler, .user_ctx = NULL };
    httpd_register_uri_handler(server, &stream_uri);

    httpd_uri_t control_uri = { .uri = "/control", .method = HTTP_GET, .handler = control_handler, .user_ctx = NULL };
    httpd_register_uri_handler(server, &control_uri);
  }
  Serial.println("Server started - Camera is priority #1");
}

void loop() {
  delay(10);
}

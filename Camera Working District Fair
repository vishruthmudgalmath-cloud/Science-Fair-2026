  .grid { display: grid; justify-content: center; gap: 10px; grid-template-areas: ". u ." "l s r" ". d ."; margin-top: 20px; }
  .btn { width: 80px; height: 80px; background: #1e293b; color: #60a5fa; border: 2px solid #3b82f6; border-radius: 12px; font-size: 24px; cursor: pointer; user-select: none; }
  .btn:active { background: #3b82f6; color: white; }
  .u { grid-area: u; } .l { grid-area: l; } .r { grid-area: r; } .d { grid-area: d; } .s { grid-area: s; border-color: #ef4444; color: #ef4444; }
</style></head>
<body>
  <h3>Endoscopy Robot - Live Camera</h3>
  <div class="stream-container"><img src="/stream"></div>
  <div class="grid">

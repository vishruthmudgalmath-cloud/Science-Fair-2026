#include "esp_camera.h"
#include <WiFi.h>
#include <WiFiAP.h>
#include "esp_http_server.h"
#include <SD.h>
#include <FS.h>

const char *ssid = "XIAO_ESP32S3";
const char *password = "12345678";

// Motor + PWM pins
#define sig_up    1
#define sig_down  2
#define sig_left  3
#define sig_right 4
#define en1       5
#define en2       6

// Camera pins
#define PWDN_GPIO_NUM -1
#define RESET_GPIO_NUM -1
#define XCLK_GPIO_NUM 10
#define SIOD_GPIO_NUM 40
#define SIOC_GPIO_NUM 39
#define Y9_GPIO_NUM 48
#define Y8_GPIO_NUM 11
#define Y7_GPIO_NUM 12
#define Y6_GPIO_NUM 14
#define Y5_GPIO_NUM 16
#define Y4_GPIO_NUM 18
#define Y3_GPIO_NUM 17
#define Y2_GPIO_NUM 15
#define VSYNC_GPIO_NUM 38
#define HREF_GPIO_NUM 47
#define PCLK_GPIO_NUM 13

#define PART_BOUNDARY "123456789000000000000987654321"
static const char* _STREAM_CONTENT_TYPE = "multipart/x-mixed-replace;boundary=" PART_BOUNDARY;
static const char* _STREAM_BOUNDARY = "\r\n--" PART_BOUNDARY "\r\n";
static const char* _STREAM_PART = "Content-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n";

static const char PROGMEM index_html[] = R"rawliteral(
<!DOCTYPE html><html><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Endoscopy Robot</title>
<style>
  body { background:#0b1220; color:white; font-family:sans-serif; text-align:center; margin:0; padding:10px; }
  .stream { max-width:500px; margin:auto; border:3px solid #3b82f6; border-radius:15px; overflow:hidden; }
  .btn { width:85px; height:85px; font-size:32px; background:#1e293b; color:#60a5fa; border:2px solid #3b82f6; border-radius:12px; margin:5px; }
  .btn:active { background:#3b82f6; color:white; }
</style>
</head>
<body>
  <h3>Endoscopy Robot - Live Camera</h3>
  <div class="stream"><img src="/stream"></div>
  <div>
    <button class="btn" onmousedown="move('up')" onmouseup="move('stop')" ontouchstart="move('up')" ontouchend="move('stop')">▲</button>
    <button class="btn" onmousedown="move('left')" onmouseup="move('stop')" ontouchstart="move('left')" ontouchend="move('stop')">◀</button>
    <button class="btn" onclick="move('stop')">■</button>
    <button class="btn" onmousedown="move('right')" onmouseup="move('stop')" ontouchstart="move('right')" ontouchend="move('stop')">▶</button>
    <button class="btn" onmousedown="move('down')" onmouseup="move('stop')" ontouchstart="move('down')" ontouchend="move('stop')">▼</button>
  </div>
  <div style="margin:15px 0">
    Speed: <input type="range" id="speed" min="0" max="255" value="200" style="width:220px" oninput="updateSpeed(this.value)">
    <span id="speedval" style="font-size:13px">200</span>
  </div>
  <div>
    <button onclick="capture()" style="padding:10px 20px; background:#2563eb; color:white; border:none; border-radius:8px; margin:5px">📸 Capture Photo</button>
    <button onclick="toggleRecord()" id="recbtn" style="padding:10px 20px; background:#dc2626; color:white; border:none; border-radius:8px; margin:5px">🎥 Record Video</button>
  </div>
  <script>
    function move(dir) {
      fetch(`/control?var=${dir}&speed=${document.getElementById('speed').value}&t=${Date.now()}`, {cache: 'no-store'});
    }
    function updateSpeed(v) { document.getElementById('speedval').textContent = v; }
    function capture() { fetch('/capture'); alert('Photo saved!'); }
    let recording = false;
    function toggleRecord() {
      recording = !recording;
      fetch(`/record?state=${recording?'start':'stop'}`);
      document.getElementById('recbtn').textContent = recording ? '⏹ Stop' : '🎥 Record';
    }
  </script>

void sendsignal(int u, int d, int l, int r) {
  digitalWrite(sig_up,    u);
  digitalWrite(sig_down,  d);
  digitalWrite(sig_left,  l);
  digitalWrite(sig_right, r);
}

// AsyncWebServer + WebSocket
AsyncWebServer server(80);
AsyncWebSocket ws("/ws");

// Improved MJPEG stream handler with logging and retry
void handleStream(AsyncWebServerRequest *request) {
  AsyncWebServerResponse *response = request->beginChunkedResponse(_STREAM_CONTENT_TYPE, [](uint8_t *buffer, size_t maxLen, size_t index) -> size_t {
    static bool first = true;
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) {
      Serial.println("Camera capture FAILED in stream!");
      if (first) {
        first = false;
        size_t len = snprintf((char*)buffer, maxLen, "%s", _STREAM_BOUNDARY);
        return len;
      }
      return RESPONSE_TRY_AGAIN;
    }

    size_t sent = 0;
    if (index == 0 || first) {
      sent = snprintf((char*)buffer, maxLen, "%sContent-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n", _STREAM_BOUNDARY, fb->len);
      first = false;
    } else {
      if (fb->len > maxLen) fb->len = maxLen;
      memcpy(buffer, fb->buf, fb->len);
      sent = fb->len;
    }

    Serial.printf("Stream sent frame len=%u\n", fb->len);
    esp_camera_fb_return(fb);
    return sent;
  });

  if (!response) {
    Serial.println("Failed to create chunked response!");
    request->send(500);
    return;
  }
  request->send(response);
}

// WebSocket events
void onWsEvent(AsyncWebSocket *server, AsyncWebSocketClient *client, AwsEventType type, void *arg, uint8_t *data, size_t len) {
  if (type == WS_EVT_CONNECT) {
    Serial.printf("WebSocket client #%u connected from %s\n", client->id(), client->remoteIP().toString().c_str());
  } else if (type == WS_EVT_DISCONNECT) {
    Serial.printf("WebSocket client #%u disconnected\n", client->id());
  } else if (type == WS_EVT_DATA) {
    data[len] = 0;
    String msg = (char*)data;
    Serial.println("WS command: " + msg);

    if (msg == "up")      sendsignal(1, 0, 1, 0);
    else if (msg == "down")  sendsignal(0, 1, 0, 1);
    else if (msg == "left")  sendsignal(1, 0, 0, 1);
    else if (msg == "right") sendsignal(0, 1, 1, 0);
    else                     sendsignal(0, 0, 0, 0);
  }
}

void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("Starting...");

  // Motor pins off first
  digitalWrite(sig_up,    0);
  digitalWrite(sig_down,  0);
  digitalWrite(sig_left,  0);
  digitalWrite(sig_right, 0);

  pinMode(sig_up,    OUTPUT);
  pinMode(sig_down,  OUTPUT);
  pinMode(sig_left,  OUTPUT);
  pinMode(sig_right, OUTPUT);

  // Camera config - low res for reliability
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;
  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sscb_sda = SIOD_GPIO_NUM;
  config.pin_sscb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size   = FRAMESIZE_QQVGA;   // Smallest for reliability
  config.jpeg_quality = 30;                // Lower quality = faster
  config.fb_count     = 2;
  config.grab_mode    = CAMERA_GRAB_LATEST;
  config.fb_location  = CAMERA_FB_IN_PSRAM;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Camera init failed 0x%x\n", err);
    return;
  }
  Serial.println("Camera OK");

  WiFi.softAP(ssid, password);
  Serial.print("AP IP: "); Serial.println(WiFi.softAPIP());

  // WebSocket setup
  ws.onEvent(onWsEvent);
  server.addHandler(&ws);

  // Serve HTML
  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
    request->send_P(200, "text/html", index_html);
  });

  // MJPEG stream
  server.on("/stream", HTTP_GET, handleStream);

  server.begin();
  Serial.println("Async server + WebSocket started");
}

void loop() {
  ws.cleanupClients();
  delay(1);
}
